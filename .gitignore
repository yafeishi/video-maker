node_modules/
.venv/
__pycache__/
*.pyc
.DS_Store
*.log

# 完整字体由 setup.sh 下载（影片只提交按用字裁剪后的子集）
core/fonts/src/

# 渲染与制作中间产物（build.sh 会重新生成）
**/out/
**/stills/t_*.jpg
**/voices/*.wav
**/voices/.cache.json
**/events.json

# 用户自己的影片：默认不进 git，想提交某部片时在这里加例外
/films/*
!/films/.gitkeep
!/films/no-parade-2026/
!/films/starship-14/

# 素材小样的生成物（make-raw.mjs / core/edit 会重新做）
templates/footage-demo/raw/*.mp4
templates/footage-demo/raw/*.mov
templates/footage-demo/raw/*.m4v
templates/footage-demo/edit/work/
templates/footage-demo/edit/frames/
templates/footage-demo/edit/*.json
templates/footage-demo/lines.json
templates/footage-demo/voices/
templates/footage-demo/poster.jpg
**/voices/words.json
